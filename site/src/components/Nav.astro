---
// Fixed nav — solid white pill CTA, per approved preview.
import { t } from "@/lib/i18n";
import type { Locale } from "@/lib/site";

interface Props {
  locale: Locale;
  /** Path of this page in the other locale (lang switch link) */
  altPath: string;
}
const { locale, altPath } = Astro.props;
const d = t[locale];
---

<nav class="nav" aria-label={d.navAria}>
  <a class="brand" href={d.homeUrl}>
    <img class="logo-mark logo-mark--color" src="/logo-stacklab.svg" alt="StackLab" width="150" height="34" data-logo="color" />
    <img class="logo-mark logo-mark--bw" src="/logo-stacklab-bw.png" alt="StackLab" width="150" height="34" data-logo="bw" aria-hidden="true" />
    <span>StackLab</span>
  </a>
  <div class="links" id="navMenu">
    <a href={d.homeUrl + "#projets"}>{d.nav.projects}</a>
    <a href={d.homeUrl + "#processus"}>{d.nav.process}</a>
    <a href={d.homeUrl + "#produit"}>{d.nav.produit}</a>
    <a class="lang-panel" href={altPath} aria-label={d.langSwitchAria} hreflang={locale === "fr" ? "en" : "fr"}>{d.langSwitch}</a>
  </div>
  <button type="button" class="btn-solid" data-contact-modal="top">
    <span class="cta-label">{d.nav.cta}</span>
    <span class="cta-label-short">{d.nav.contact}</span>
  </button>
  <a class="lang" href={altPath} aria-label={d.langSwitchAria} hreflang={locale === "fr" ? "en" : "fr"}>{d.langSwitch}</a>
  <button
    type="button"
    class="nav__burger"
    data-nav-toggle
    aria-expanded="false"
    aria-controls="navMenu"
    aria-label={d.nav.menuAria}
  >
    <span class="nav__burger-bars" aria-hidden="true"></span>
  </button>
</nav>

<!-- Theme control: fixed to the bottom-left edge so it stays reachable on
     every page and at any scroll depth. The WhatsApp float owns the
     bottom-right corner, so the two never collide. -->
<button
  type="button"
  class="theme-toggle"
  data-theme-toggle
  aria-label={d.themeToggleAria}
  title={d.themeToggleAria}
>
  <span class="theme-toggle-icon" aria-hidden="true"></span>
</button>

<script>
  // Theme toggle: flips data-theme, persists the choice, syncs theme-color.
  (function () {
    "use strict";
    const root = document.documentElement;
    const btn = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
    if (!btn) return;

    const meta = document.querySelector<HTMLMetaElement>("[data-theme-color]");
    const LIGHT_BG = "#ffffff";
    const DARK_BG = "#0a0a0a";

    function apply(theme: string, persist: boolean) {
      root.setAttribute("data-theme", theme);
      if (persist) {
        try { localStorage.setItem("stacklab-theme", theme); } catch (e) { /* private mode */ }
      }
      if (meta) meta.setAttribute("content", theme === "light" ? LIGHT_BG : DARK_BG);
    }

    apply(root.getAttribute("data-theme") === "light" ? "light" : "dark", false);

    btn.addEventListener("click", () => {
      apply(root.getAttribute("data-theme") === "light" ? "dark" : "light", true);
    });

    // Proximity reveal: button stays invisible until mouse approaches
    window.addEventListener("pointermove", (e) => {
      const rect = btn.getBoundingClientRect();
      const cx = rect.left + rect.width / 2;
      const cy = rect.top + rect.height / 2;
      const dist = Math.hypot(e.clientX - cx, e.clientY - cy);
      if (dist < 130 || (e.clientX < 110 && e.clientY > window.innerHeight - 110)) {
        btn.setAttribute("data-visible", "true");
      } else {
        btn.removeAttribute("data-visible");
      }
    }, { passive: true });

    window.addEventListener("pointerleave", () => {
      btn.removeAttribute("data-visible");
    });
  })();

  // Mobile menu: conventional hamburger toggle. Opens the dropdown panel
  // with the primary links; closes on link tap, Escape, outside click, or
  // when the viewport grows past the mobile breakpoint.
  (function () {
    "use strict";
    const nav = document.querySelector<HTMLElement>(".nav");
    const burger = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
    if (!nav || !burger) return;

    const setOpen = (open: boolean) => {
      nav.toggleAttribute("data-open", open);
      burger.setAttribute("aria-expanded", String(open));
    };

    burger.addEventListener("click", () => setOpen(!nav.hasAttribute("data-open")));
    nav.querySelector(".links")?.addEventListener("click", (e) => {
      if ((e.target as Element).closest("a")) setOpen(false);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && nav.hasAttribute("data-open")) {
        setOpen(false);
        burger.focus();
      }
    });
    document.addEventListener("click", (e) => {
      if (nav.hasAttribute("data-open") && !nav.contains(e.target as Node)) setOpen(false);
    });
    window.matchMedia("(min-width: 841px)").addEventListener("change", (e) => {
      if (e.matches) setOpen(false);
    });
  })();
</script>
