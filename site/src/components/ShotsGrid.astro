---
// "Dans les coulisses" — asymmetric editorial 12-col grid driven by the
// projects' own orderIndex: one full-width feature tile (the first project),
// then interlocking 7/5 and 5/7 rows. Every tile is a stretched link to its
// case study. A prev/next navigator steps through projects in the same order,
// scrolls to the first tile of the selected project, highlights it, and
// announces it politely for assistive tech.
import { t } from "@/lib/i18n";
import { projects, projectPath, type Locale } from "@/lib/site";
import ProjectNavigator from "@/components/ProjectNavigator.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t[locale];

// Every screenshot a project actually has, taken from its own
// `fallbackScreenshots` list — nothing hardcoded, nothing repeated, and a
// project with four captures shows all four.
function shotsOf(p: (typeof projects)[number]): string[] {
  const shots = (p.fallbackScreenshots ?? []).filter((u) => /\.webp$/i.test(u));
  return shots.length ? shots : [];
}

/** Column spans for N tiles with no empty cell:
 *  odd N  -> one full-width opener, then 7/5 pairs
 *  even N -> 7/5 pairs throughout                          */
function spans(n: number): string[] {
  if (n <= 1) return ["s12"];
  const out = n % 2 === 1 ? ["s12"] : [];
  while (out.length < n) out.push(out.length % 2 === (n % 2 === 1 ? 1 : 0) ? "s7" : "s5");
  return out.slice(0, n);
}

const ASPECT: Record<string, [number, number]> = {
  s12: [1440, 630],
  s7: [1440, 900],
  s5: [1440, 1080],
};

const SHORT: Record<string, { fr: string; en: string }> = {
  lahyani: { fr: "Lahyani", en: "Lahyani" },
  auradrive: { fr: "AuraDrive", en: "AuraDrive" },
  "saveur-charme": { fr: "Saveur & Charme", en: "Saveur & Charme" },
  kfresh: { fr: "KFresh", en: "KFresh" },
  sigmaparts: { fr: "SigmaParts", en: "SigmaParts" },
  promptifyapp: { fr: "PromptifyApp", en: "PromptifyApp" },
};

const captionOf = (src: string, fallback: string) => {
  const key = src.split("/").pop()?.replace(/\.webp$/i, "") ?? "";
  return d.shotCaptions[key as keyof typeof d.shotCaptions] ?? fallback;
};

// Projects in display order (orderIndex asc), each owning all of its shots.
const ordered = [...projects]
  .map((p) => ({ p, shots: shotsOf(p) }))
  .filter((x) => x.shots.length)
  .sort((a, b) => (a.p.orderIndex ?? 99) - (b.p.orderIndex ?? 99))
  .map(({ p, shots }, i) => {
    const cols = spans(shots.length);
    const fallback = `${locale === "fr" ? p.nameFr : p.nameEn} — ${locale === "fr" ? p.sectorFr : p.sectorEn}`;
    return {
      index: i,
      slug: p.slug,
      short: SHORT[p.slug]?.[locale] ?? (locale === "fr" ? p.nameFr : p.nameEn),
      href: projectPath(p, locale),
      tiles: shots.map((src, t) => {
        const cls = cols[t];
        const [w, h] = ASPECT[cls] ?? ASPECT.s7;
        return { img: src, w, h, cls, cap: captionOf(src, fallback) };
      }),
    };
  });

---

<section id="coulisses">
  <div class="sec-head sr">
    <h2 set:html={d.coulisses.title} />
    <span class="idx">{d.coulisses.idx}</span>
  </div>

  <ProjectNavigator
    locale={locale}
    uid="shots"
    items={ordered.map((g) => ({ slug: g.slug, name: g.short }))}
  />

  <div class="shots">
    {ordered.map((g) => (
      <div class="shots-group" data-shots-group={g.slug}>
        {g.tiles.map((tile) => (
          <figure class={`shot ${tile.cls} sr`}>
            <a class="shot-link" href={g.href} aria-label={tile.cap} />
            <div class="frame">
              <img
                src={tile.img}
                alt={tile.cap}
                width={tile.w}
                height={tile.h}
                loading="lazy"
                decoding="async"
              />
            </div>
            <figcaption>
              <span class="cap">{tile.cap}</span>
              <span class="arr" aria-hidden="true">↗</span>
            </figcaption>
          </figure>
        ))}
      </div>
    ))}
  </div>
</section>

<script>
  // Only the selected project's screenshots are visible; the shared
  // navigator (the same one driving the live preview and the flow map)
  // decides which one that is, so the three sections never disagree.
  document.querySelectorAll<HTMLElement>("#coulisses").forEach((root) => {
    const groups = [...root.querySelectorAll<HTMLElement>("[data-shots-group]")];
    if (!groups.length) return;

    const show = (slug: string) => {
      const next = groups.find((g) => g.dataset.shotsGroup === slug) ?? groups[0];
      groups.forEach((g) => {
        g.hidden = g !== next;
        g.querySelectorAll<HTMLElement>(".shot").forEach((t) => {
          t.toggleAttribute("data-active", g === next);
          // Tiles start hidden (opacity 0) until the scroll reveal marks them.
          // A tile revealed by a project switch — especially one chosen while
          // this section is off-screen — would otherwise stay invisible, so the
          // reveal is forced here instead of waiting on the observer.
          if (g === next) t.classList.add("in");
        });
      });
      // A lazy image that was inside a hidden group never started fetching, and
      // revealing the group does not always restart it — promote it to eager.
      next?.querySelectorAll<HTMLImageElement>("img").forEach((im) => {
        if (!im.complete) im.loading = "eager";
      });

      // Picking a project from anywhere on the page must visibly land the
      // reader on the result: if the screenshots are off-screen, bring them
      // into view instead of swapping them silently behind the fold.
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const rect = root.getBoundingClientRect();
      const offScreen = rect.bottom < 120 || rect.top > window.innerHeight - 80;
      if (offScreen) {
        const top = rect.top + window.scrollY - 40;
        window.scrollTo({ top, behavior: reduced ? "instant" : "smooth" });
      }
    };

    root.addEventListener("pnav:change", (e) => {
      show((e as CustomEvent<{ slug: string }>).detail?.slug ?? "");
    });

    const current = document.documentElement.getAttribute("data-active-project");
    if (current) show(current);
  });
</script>
