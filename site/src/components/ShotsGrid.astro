---
// "Dans les coulisses" — asymmetric editorial 12-col grid driven by the
// projects' own orderIndex: one full-width feature tile (the first project),
// then interlocking 7/5 and 5/7 rows. Every tile is a stretched link to its
// case study. A prev/next navigator steps through projects in the same order,
// scrolls to the first tile of the selected project, highlights it, and
// announces it politely for assistive tech.
import { t } from "@/lib/i18n";
import { projects, projectPath, type Locale } from "@/lib/site";
import ProjectNavigator from "@/components/ProjectNavigator.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t[locale];

// Which screenshot plays each layout role, per project (order = orderIndex),
// with the i18n caption key for each tile.
const SHOTS: Record<string, { full: string; a: string; b: string }> = {
  "lahyani": {
    full: "/projects/lahyani/lahyani-booking.webp",
    a: "/projects/lahyani/lahyani-hero.webp",
    b: "/projects/lahyani/lahyani-booking.webp",
  },
  "auradrive": {
    full: "/projects/auradrive/auradrive-hero.webp",
    a: "/projects/auradrive/auradrive-catalog.webp",
    b: "/projects/auradrive/auradrive-admin.webp",
  },
  "saveur-charme": {
    full: "/projects/saveur-charme/saveur-charme-admin.webp",
    a: "/projects/saveur-charme/saveur-charme-menu.webp",
    b: "/projects/saveur-charme/saveur-charme-admin-menu.webp",
  },
  "kfresh": {
    full: "/projects/kfresh/kfresh-shop.webp",
    a: "/projects/kfresh/kfresh-hero.webp",
    b: "/projects/kfresh/kfresh-shop.webp",
  },
  "sigmaparts": {
    full: "/projects/sigmaparts/sigmaparts-hero.webp",
    a: "/projects/sigmaparts/sigmaparts-hero.webp",
    b: "/projects/sigmaparts/sigmaparts-hero.webp",
  },
  "promptifyapp": {
    full: "/projects/promptifyapp/promptifyapp-hero.webp",
    a: "/projects/promptifyapp/promptifyapp-hero.webp",
    b: "/projects/promptifyapp/promptifyapp-hero.webp",
  },
};

const CAPTION: Record<string, string> = {
  "lahyani": { full: "lahyani-booking", a: "lahyani-hero", b: "lahyani-booking" },
  "auradrive": { full: "auradrive-hero", a: "auradrive-catalog", b: "auradrive-admin" },
  "saveur-charme": { full: "saveur-charme-admin", a: "saveur-charme-menu", b: "saveur-charme-admin-menu" },
  kfresh: { full: "kfresh-shop", a: "kfresh-hero", b: "kfresh-shop" },
  sigmaparts: { full: "sigmaparts-hero", a: "sigmaparts-hero", b: "sigmaparts-hero" },
  promptifyapp: { full: "promptifyapp-hero", a: "promptifyapp-hero", b: "promptifyapp-hero" },
} as any;

const SHORT: Record<string, { fr: string; en: string }> = {
  lahyani: { fr: "Lahyani", en: "Lahyani" },
  auradrive: { fr: "AuraDrive", en: "AuraDrive" },
  "saveur-charme": { fr: "Saveur & Charme", en: "Saveur & Charme" },
  kfresh: { fr: "KFresh", en: "KFresh" },
  sigmaparts: { fr: "SigmaParts", en: "SigmaParts" },
  promptifyapp: { fr: "PromptifyApp", en: "PromptifyApp" },
};

// Projects in display order (orderIndex asc), each with the tiles it owns.
const ordered = [...projects]
  .filter((p) => SHOTS[p.slug])
  .sort((a, b) => (a.orderIndex ?? 99) - (b.orderIndex ?? 99))
  .map((p, i) => {
    const s = SHOTS[p.slug];
    const cap = CAPTION[p.slug];
    const fallback = `${p.nameFr} — ${p.sectorFr}`;
    const capOf = (key: "full" | "a" | "b") =>
      d.shotCaptions[cap[key] as keyof typeof d.shotCaptions] ?? fallback;
    return {
      index: i,
      slug: p.slug,
      short: SHORT[p.slug][locale],
      name: locale === "fr" ? p.nameFr : p.nameEn,
      href: projectPath(p, locale),
      // First project gets the full-width feature tile; the rest alternate 7/5.
      full: i === 0,
      tiles: i === 0
        ? [{ img: s.full, w: 1440, h: 630, cls: "s12", cap: capOf("full") }]
        : [
            { img: s.a, w: 1440, h: 900, cls: "s7", cap: capOf("a") },
            { img: s.b, w: 1440, h: 1080, cls: "s5", cap: capOf("b") },
          ],
    };
  });
---

<section id="coulisses">
  <div class="sec-head sr">
    <h2 set:html={d.coulisses.title} />
    <span class="idx">{d.coulisses.idx}</span>
  </div>

  <ProjectNavigator
    locale={locale}
    uid="shots"
    items={ordered.map((g) => ({ slug: g.slug, name: g.short }))}
  />

  <div class="shots">
    {ordered.map((g) => (
      <div class="shots-group" data-shots-group={g.slug}>
        {g.tiles.map((tile) => (
          <figure class={`shot ${tile.cls} sr`}>
            <a class="shot-link" href={g.href} aria-label={tile.cap} />
            <div class="frame">
              <img
                src={tile.img}
                alt={tile.cap}
                width={tile.w}
                height={tile.h}
                loading="lazy"
                decoding="async"
              />
            </div>
            <figcaption>
              <span class="cap">{tile.cap}</span>
              <span class="arr" aria-hidden="true">↗</span>
            </figcaption>
          </figure>
        ))}
      </div>
    ))}
  </div>
</section>

<script>
  // Only the selected project's screenshots are visible; the shared
  // navigator (the same one driving the live preview and the flow map)
  // decides which one that is, so the three sections never disagree.
  document.querySelectorAll<HTMLElement>("#coulisses").forEach((root) => {
    const groups = [...root.querySelectorAll<HTMLElement>("[data-shots-group]")];
    if (!groups.length) return;

    const show = (slug: string) => {
      const next = groups.find((g) => g.dataset.shotsGroup === slug) ?? groups[0];
      groups.forEach((g) => {
        g.hidden = g !== next;
        g.querySelectorAll<HTMLElement>(".shot").forEach((t) => t.toggleAttribute("data-active", g === next));
      });
    };

    root.addEventListener("pnav:change", (e) => {
      show((e as CustomEvent<{ slug: string }>).detail?.slug ?? "");
    });

    const current = document.documentElement.getAttribute("data-active-project");
    if (current) show(current);
  });
</script>
