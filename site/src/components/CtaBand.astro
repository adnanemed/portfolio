---
// Case-study CTA band — contact modal (primary) + back to projects.
import { t } from "@/lib/i18n";
import { localePath, type Locale } from "@/lib/site";

interface Props {
  locale: Locale;
  projectName: string;
}
const { locale, projectName } = Astro.props;
const d = t[locale];
const waText = d.caseStudy.waText.replace("{name}", projectName);
---

<div class="cta-band v8">
  <div>
    <h2 set:html={d.caseStudy.ctaTitle} />
    <p class="arch-caption" style="margin-top:.8rem">{d.caseStudy.ctaNote}</p>
  </div>
  <div class="actions">
    <button type="button" class="btn-primary8 btn-lg8" data-contact-modal="bottom" data-wa-text={waText}>
      {d.contact.megaCta} <span class="arr" aria-hidden="true">→</span>
    </button>
    <a class="btn-ghost8" href={localePath("/", locale)}>{d.caseStudy.back} <span class="arr" aria-hidden="true">→</span></a>
  </div>
</div>
