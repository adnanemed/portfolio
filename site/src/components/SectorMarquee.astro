---
// Sector marquee — constant linear motion, static under reduced motion.
import { t } from "@/lib/i18n";
import type { Locale } from "@/lib/site";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t[locale];
const items = [...d.marquee, ...d.marquee]; // duplicate track for the -50% loop
---

<div class="marquee" aria-hidden="true">
  <div class="track">
    {items.map((s, i) => (
      <>
        <span>{s}</span>
        {i < items.length - 1 && <span class="serif">—</span>}
      </>
    ))}
  </div>
</div>
