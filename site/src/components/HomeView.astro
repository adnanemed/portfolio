---
// Home view shared by / (FR) and /en/ (EN) — sections exactly per the
// approved preview: hero, stats, marquee, case index, coulisses, live
// demo, architecture, anatomy, manifesto, process, contact, footer.
import { t } from "@/lib/i18n";
import { projects, SOCIALS, WHATSAPP_FALLBACK, waLink, type Locale } from "@/lib/site";
import Nav from "@/components/Nav.astro";
import Hero from "@/components/Hero.astro";
import Stats from "@/components/Stats.astro";
import SectorMarquee from "@/components/SectorMarquee.astro";
import CaseIndex from "@/components/CaseIndex.astro";
import ShotsGrid from "@/components/ShotsGrid.astro";
import LiveDemo from "@/components/LiveDemo.astro";
import FlowMap from "@/components/FlowMap.astro";
import AnatomyRows from "@/components/AnatomyRows.astro";
import Manifesto from "@/components/Manifesto.astro";
import ContactSection from "@/components/ContactSection.astro";
import SiteFooter from "@/components/SiteFooter.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t[locale];

// All six projects, in editorial order — drives the flow map (FIX 2)
// and the live-preview navigator (FIX 3). Data lives in content.json.
const ordered = [...projects].sort((a, b) => a.orderIndex - b.orderIndex);

const flowItems = ordered.map((p) => ({
  slug: p.slug,
  name: locale === "fr" ? p.nameFr : p.nameEn,
  sector: locale === "fr" ? p.sectorFr : p.sectorEn,
  intro: (locale === "fr" ? p.flowIntroFr : p.flowIntroEn) ?? "",
  steps: (locale === "fr" ? p.flowStepsFr : p.flowStepsEn) ?? [],
}));

const waNumber = SOCIALS.whatsapp || WHATSAPP_FALLBACK || null;
const waHref = waNumber ? waLink(waNumber, d.contact.waText) : null;
---

<Nav locale={locale} altPath={locale === "fr" ? "/en/" : "/"} />

<main id="main">
  <Hero locale={locale} />
  <Stats locale={locale} />
  <SectorMarquee locale={locale} />

  <CaseIndex locale={locale} />

  <ShotsGrid locale={locale} />

  <section id="apercu">
    <div class="sec-head sr">
      <h2 set:html={d.demo.title} />
      <span class="idx">{d.demo.idx}</span>
    </div>
    <LiveDemo locale={locale} projects={ordered} />
  </section>

  <section id="architecture">
    <div class="sec-head sr">
      <h2 set:html={d.arch.title} />
      <span class="idx">{d.arch.idx}</span>
    </div>
    <FlowMap locale={locale} items={flowItems} />
  </section>

  <section id="anatomie">
    <div class="sec-head sr">
      <h2 set:html={d.anatomy.title} />
      <span class="idx">{d.anatomy.idx}</span>
    </div>
    <AnatomyRows rows={d.anatomy.rows} />
  </section>

  <Manifesto locale={locale} />

  <section id="processus">
    <div class="sec-head sr">
      <h2 set:html={d.process.title} />
      <span class="idx">{d.process.idx}</span>
    </div>
    <AnatomyRows rows={d.process.rows} />
  </section>

  <ContactSection locale={locale} />
</main>

<SiteFooter locale={locale} />

{waHref && (
  <a class="wa-float" href={waHref} target="_blank" rel="noopener noreferrer" data-wa-float>
    {d.waFloat} <span aria-hidden="true">↗</span>
  </a>
)}

<script>
  import { initRefresh } from "@/lib/refresh";
  initRefresh();
</script>
