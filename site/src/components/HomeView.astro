---
// Home view v8 shared by / (FR) and /en/ (EN). Slim conversion skeleton:
// hero → projects (live links + case studies) → 3D pipeline (method) →
// PromptifyApp product → discreet contact end + footer. The contact form
// lives in the global modal (ContactModal), opened by every [data-contact-modal]
// CTA. All WebGL is a decorative enhancement layer; content is plain HTML.
import { t } from "@/lib/i18n";
import { SOCIALS, WHATSAPP_FALLBACK, waLink, type Locale } from "@/lib/site";
import Nav from "@/components/Nav.astro";
import Hero3D from "@/components/Hero3D.astro";
import ProjectRows from "@/components/ProjectRows.astro";
import Pipeline3D from "@/components/Pipeline3D.astro";
import PromptifyForge from "@/components/PromptifyForge.astro";
import ContactEnd from "@/components/ContactEnd.astro";
import SiteFooter from "@/components/SiteFooter.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t[locale];

const waNumber = SOCIALS.whatsapp || WHATSAPP_FALLBACK || null;
const waHref = waNumber ? waLink(waNumber, d.contact.waText) : null;
---

<Nav locale={locale} altPath={locale === "fr" ? "/en/" : "/"} />

<main id="main">
  <Hero3D locale={locale} />

  <ProjectRows locale={locale} />

  <Pipeline3D locale={locale} />

  <PromptifyForge locale={locale} />

  <ContactEnd locale={locale} />
</main>

<SiteFooter locale={locale} />

{waHref && (
  <a class="wa-float" href={waHref} target="_blank" rel="noopener noreferrer" data-wa-float>
    {d.waFloat} <span aria-hidden="true">↗</span>
  </a>
)}

<script>
  // v8 orchestrator: GSAP + Lenis + tilt + pins + chat, and the tier-gated
  // dynamic import of the Three.js scenes (hero, pipeline).
  import "@/scripts/v8/home";
  import { initRefresh } from "@/lib/refresh";
  initRefresh();
</script>
