---
// v8 hero — WebGL node engine behind giant display type.
// Canvas + fallback layer are decorative (aria-hidden); the copy is plain
// HTML, so the hero is fully readable with JS disabled or reduced motion.
import { t } from "@/lib/i18n";
import type { Locale } from "@/lib/site";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t[locale].v8.hero;
---

<header class="hero3d v8" id="top">
  <div class="hero3d__fallback" aria-hidden="true"></div>
  <canvas class="hero3d__canvas" id="heroCanvas" aria-hidden="true"></canvas>
  <div class="hero3d__inner">
    <h1 data-v8-hero>
      <span>{d.titleA}</span>
      <span class="v8-grad">{d.titleB}</span>
    </h1>
    <p class="hero3d__sub" data-v8-hero>{d.sub}</p>
    <div class="hero3d__ctas" data-v8-hero>
      <button type="button" class="btn-primary8 btn-lg8" data-contact-modal>
        {t[locale].hero.cta} <span class="arr" aria-hidden="true">→</span>
      </button>
      <a class="btn-ghost8 btn-lg8" href="#projets">{d.cta2}</a>
    </div>
  </div>
  <div class="hero3d__fps" id="v8fps" hidden>— FPS</div>
</header>
