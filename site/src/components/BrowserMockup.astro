---
// Browser mockup — mono URL pill + click-to-load iframe with skeleton
// shimmer and an 8s timeout fallback note. The iframe only loads after
// an explicit click (no third-party requests before consent).
// Never renders a hard-coded iframe: driven entirely by the `url` prop
// (guarded by iframeEmbeddable from content.json / the API).
import { t } from "@/lib/i18n";
import type { Locale } from "@/lib/site";

interface Props {
  url: string;
  locale: Locale;
  title?: string;
  uid?: string; // unique id suffix when several mockups share a page
  displayHost?: string;
  openUrl?: string;
}
const { url, locale, uid = "main", displayHost, openUrl } = Astro.props;
const d = t[locale];
const host = displayHost || (() => {
  try {
    return new URL(url).host;
  } catch {
    return url;
  }
})();
const targetOpen = openUrl || url;
const id = (name: string) => `${name}-${uid}`;
---

<div class="browser sr">
  <div class="chrome">
    <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="url">{host}</span>
    <span class="live-badge">{d.demo.liveBadge}</span>
  </div>
  <div class="demo-screen" id={id("demoScreen")}>
    <div class="skeleton" aria-hidden="true"></div>
    <div class="screen-cta" id={id("demoIntro")}>
      <p class="hint">{d.demo.hint}</p>
      <button class="btn-wipe" id={id("demoLoad")} type="button" data-demo-src={url} data-demo-slot={id("demoSlot")} data-demo-note={id("demoNote")} data-demo-screen={id("demoScreen")}>
        {d.demo.load} <span class="arr" aria-hidden="true">↗</span>
      </button>
      <a class="alt-link" href={targetOpen} target="_blank" rel="noopener noreferrer">{d.demo.open} ↗</a>
    </div>
    <div id={id("demoSlot")}></div>
  </div>
</div>
<p class="demo-note sr" id={id("demoNote")} hidden>
  {d.demo.notePre}<a href={url} target="_blank" rel="noopener noreferrer">{d.demo.noteLink}</a>
</p>
<script>
  // Click-to-load: create the iframe on demand; fade in on load; show the
  // fallback note if the frame hasn't loaded within 8s.
  document.querySelectorAll<HTMLButtonElement>("[data-demo-src]").forEach((btn) => {
    let started = false;
    btn.addEventListener("click", () => {
      if (started) return;
      started = true;
      btn.disabled = true;
      const src = btn.getAttribute("data-demo-src")!;
      const screen = document.getElementById(btn.getAttribute("data-demo-screen")!)!;
      const note = document.getElementById(btn.getAttribute("data-demo-note")!);
      const slot = document.getElementById(btn.getAttribute("data-demo-slot")!);
      const frame = document.createElement("iframe");
      frame.className = "demo-frame";
      frame.src = src;
      frame.title = btn.closest(".browser")?.querySelector(".url")?.textContent || "Live preview";
      frame.setAttribute("loading", "lazy");
      frame.setAttribute("referrerpolicy", "no-referrer-when-downgrade");
      slot?.appendChild(frame);
      const timer = setTimeout(() => {
        if (note) note.hidden = false;
      }, 8000);
      frame.addEventListener("load", () => {
        clearTimeout(timer);
        screen.classList.add("live");
      });
    });
  });
</script>
