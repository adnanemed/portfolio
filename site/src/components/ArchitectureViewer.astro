---
// Architecture viewer — dark canvas, zoom +/−/reset, drag pan, keyboard
// accessible (arrows / + / − / 0). Multiple diagrams get switch chips.
import { t } from "@/lib/i18n";
import type { Locale } from "@/lib/site";

export type ArchDiagram = {
  key: string;
  name: string;
  src: string;
  alt: string;
  caption: string;
};

interface Props {
  locale: Locale;
  diagrams: ArchDiagram[];
  uid?: string;
}
const { locale, diagrams, uid = "main" } = Astro.props;
const d = t[locale];
const first = diagrams[0];
const multi = diagrams.length > 1;
const id = (n: string) => `${n}-${uid}`;
---

<div class="sr">
  <div class="arch-toolbar">
    {multi && (
      <div class="chips" role="group" aria-label={d.arch.groupLabel}>
        {diagrams.map((dg, i) => (
          <button
            class="chip"
            type="button"
            data-arch={dg.key}
            data-arch-src={dg.src}
            data-arch-alt={dg.alt}
            data-arch-caption={dg.caption}
            aria-pressed={i === 0 ? "true" : "false"}
          >
            {dg.name}
          </button>
        ))}
      </div>
    )}
    <div class="zoom" role="group" aria-label={d.arch.zoomLabel}>
      <button class="zbtn" type="button" data-arch-zoom="in" aria-label={d.arch.zoomIn}>+</button>
      <button class="zbtn" type="button" data-arch-zoom="out" aria-label={d.arch.zoomOut}>−</button>
      <button class="zbtn" type="button" data-arch-zoom="reset" aria-label={d.arch.reset}>reset</button>
    </div>
  </div>
  <div
    class="arch-viewport"
    id={id("archViewport")}
    tabindex="0"
    role="img"
    aria-label={d.arch.viewportAria}
  >
    <img
      id={id("archImg")}
      src={first.src}
      alt={first.alt}
      loading="lazy"
      decoding="async"
      draggable="false"
    />
  </div>
  <p class="arch-caption mono" id={id("archCaption")}>{first.caption}</p>
  <p class="arch-hint mono">{d.arch.hint}</p>
</div>

<script>
  // Zoom/pan viewer, transform-only, pan clamped. Scope: each viewport
  // instance manages its own toolbar via closest('.sr') container.
  document.querySelectorAll<HTMLElement>(".arch-viewport").forEach((vp) => {
    const img = vp.querySelector<HTMLImageElement>("img");
    if (!img) return;
    const container = vp.closest<HTMLElement>(".sr") ?? vp.parentElement!;
    const scaleMin = 1, scaleMax = 4;
    let scale = 1, px = 0, py = 0;

    const clampPan = () => {
      const hw = (img.offsetWidth * scale) / 2;
      const hh = (img.offsetHeight * scale) / 2;
      const vw = vp.clientWidth / 2;
      const vh = vp.clientHeight / 2;
      const mx = Math.max(0, hw - vw);
      const my = Math.max(0, hh - vh);
      px = Math.min(mx, Math.max(-mx, px));
      py = Math.min(my, Math.max(-my, py));
    };
    const apply = () => {
      clampPan();
      img.style.transform = `translate(${px}px,${py}px) scale(${scale})`;
    };
    const resetView = () => {
      scale = 1;
      px = 0;
      py = 0;
      apply();
    };
    const zoomAt = (ratio: number) => {
      const ns = Math.min(scaleMax, Math.max(scaleMin, scale * ratio));
      if (ns === scale) return;
      const r = ns / scale;
      px *= r;
      py *= r;
      scale = ns;
      apply();
    };

    container.querySelectorAll<HTMLButtonElement>("[data-arch-zoom]").forEach((b) => {
      b.addEventListener("click", () => {
        const z = b.getAttribute("data-arch-zoom");
        if (z === "in") zoomAt(1.35);
        else if (z === "out") zoomAt(1 / 1.35);
        else resetView();
      });
    });

    let dragging = false;
    let lx = 0, ly = 0;
    vp.addEventListener("pointerdown", (e) => {
      dragging = true;
      lx = e.clientX;
      ly = e.clientY;
      vp.classList.add("dragging");
      try {
        vp.setPointerCapture(e.pointerId);
      } catch {
        /* older engines */
      }
    });
    vp.addEventListener("pointermove", (e) => {
      if (!dragging) return;
      px += e.clientX - lx;
      py += e.clientY - ly;
      lx = e.clientX;
      ly = e.clientY;
      apply();
    });
    ["pointerup", "pointercancel"].forEach((ev) =>
      vp.addEventListener(ev, () => {
        dragging = false;
        vp.classList.remove("dragging");
      })
    );

    vp.addEventListener("keydown", (e) => {
      const step = 60;
      let handled = true;
      switch (e.key) {
        case "ArrowLeft": px -= step; break;
        case "ArrowRight": px += step; break;
        case "ArrowUp": py -= step; break;
        case "ArrowDown": py += step; break;
        case "+":
        case "=": zoomAt(1.25); break;
        case "-": zoomAt(1 / 1.25); break;
        case "0": resetView(); break;
        default: handled = false;
      }
      if (handled) {
        e.preventDefault();
        apply();
      }
    });

    window.addEventListener("resize", apply);

    // Diagram chips (multi-diagram viewer)
    const chips = container.querySelectorAll<HTMLButtonElement>(".chip[data-arch]");
    chips.forEach((btn) => {
      btn.addEventListener("click", () => {
        chips.forEach((b) => b.setAttribute("aria-pressed", "false"));
        btn.setAttribute("aria-pressed", "true");
        img.src = btn.getAttribute("data-arch-src") ?? img.src;
        img.alt = btn.getAttribute("data-arch-alt") ?? "";
        const cap = container.querySelector<HTMLElement>(".arch-caption");
        if (cap) cap.textContent = btn.getAttribute("data-arch-caption") ?? "";
        resetView();
      });
    });
  });
</script>
