---
// Project navigator — shared by the home "flow map" (FIX 2) and the
// "live preview" section (FIX 3): visible prev/next arrows + one chip
// per project (aria-pressed). One instance manages its own selection
// and notifies its section via a bubbling `pnav:change` event, so each
// section reacts independently. Keyboard: ArrowLeft / ArrowRight move
// the selection; every control is a real 44px button.
import { t } from "@/lib/i18n";
import type { Locale } from "@/lib/site";

export interface NavItem {
  slug: string;
  name: string;
}

interface Props {
  locale: Locale;
  uid: string; // unique per section ("flow" / "demo")
  items: NavItem[];
  label?: string;
}
const { locale, uid, items, label } = Astro.props;
const d = t[locale];
---

<div class="pnav sr" data-pnav={uid} role="group" aria-label={label ?? d.pnav.group}>
  <button class="nbtn" type="button" data-pnav-dir="prev" aria-label={d.pnav.prev}>
    <span aria-hidden="true">←</span>
  </button>
  <div class="pnav-chips">
    {items.map((it, i) => (
      <button
        class="chip"
        type="button"
        data-pnav-chip={i}
        aria-pressed={i === 0 ? "true" : "false"}
      >
        {it.name}
      </button>
    ))}
  </div>
  <button class="nbtn" type="button" data-pnav-dir="next" aria-label={d.pnav.next}>
    <span aria-hidden="true">→</span>
  </button>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-pnav]").forEach((nav) => {
    const chips = [...nav.querySelectorAll<HTMLButtonElement>("[data-pnav-chip]")];
    if (!chips.length) return;
    let index = 0;

    const emit = () => {
      chips.forEach((c, i) => c.setAttribute("aria-pressed", i === index ? "true" : "false"));
      nav.dispatchEvent(
        new CustomEvent("pnav:change", { detail: { index }, bubbles: true })
      );
    };

    const go = (delta: number) => {
      const n = chips.length;
      index = (index + delta + n) % n;
      emit();
      chips[index].focus();
    };

    chips.forEach((chip, i) =>
      chip.addEventListener("click", () => {
        index = i;
        emit();
      })
    );
    nav
      .querySelector<HTMLButtonElement>('[data-pnav-dir="prev"]')
      ?.addEventListener("click", () => go(-1));
    nav
      .querySelector<HTMLButtonElement>('[data-pnav-dir="next"]')
      ?.addEventListener("click", () => go(1));

    nav.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") {
        e.preventDefault();
        go(-1);
      } else if (e.key === "ArrowRight") {
        e.preventDefault();
        go(1);
      }
    });
  });
</script>
