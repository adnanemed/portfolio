---
// Project navigator — shared by the home "flow map" (FIX 2) and the
// "live preview" section (FIX 3): visible prev/next arrows + one chip
// per project (aria-pressed). One instance manages its own selection
// and notifies its section via a bubbling `pnav:change` event, so each
// section reacts independently. Keyboard: ArrowLeft / ArrowRight move
// the selection; every control is a real 44px button.
import { t } from "@/lib/i18n";
import type { Locale } from "@/lib/site";

export interface NavItem {
  slug: string;
  name: string;
}

interface Props {
  locale: Locale;
  uid: string; // unique per section ("flow" / "demo")
  items: NavItem[];
  label?: string;
}
const { locale, uid, items, label } = Astro.props;
const d = t[locale];
---

<div class="pnav sr" data-pnav={uid} role="group" aria-label={label ?? d.pnav.group}>
  <button class="nbtn" type="button" data-pnav-dir="prev" aria-label={d.pnav.prev}>
    <span aria-hidden="true">←</span>
  </button>
  <div class="pnav-chips">
    {items.map((it) => (
      <button
        class="chip"
        type="button"
        data-pnav-chip={it.slug}
        aria-pressed="false"
      >
        {it.name}
      </button>
    ))}
  </div>
  <button class="nbtn" type="button" data-pnav-dir="next" aria-label={d.pnav.next}>
    <span aria-hidden="true">→</span>
  </button>
</div>

<script>
  // Navigation state is global: every navigator on the page (screenshots,
  // live preview, flow map) shares one selection, so picking a project in
  // one section moves the others too.
  import { bindNavigator } from "@/lib/project-store";

  document.querySelectorAll<HTMLElement>("[data-pnav]").forEach((nav) => {
    bindNavigator(nav);
  });
</script>
