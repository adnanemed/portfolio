---
// Case-study view v8 — every /projets/[slug] page follows the approved
// problem → solution → result presentation (pinned scrub on desktop, stacked
// on mobile), the shader gallery of the project's 3 real screenshots, the
// detailed flow map, and the contact modal CTA. Texts come from
// content.json (owner-validated); runtime refresh keeps working via data-cs.
import { t, tagLabel } from "@/lib/i18n";
import { projectByLocale, type Locale, type Project } from "@/lib/site";
import { hashJson } from "@/lib/hash";
import Nav from "@/components/Nav.astro";
import CaseGallery from "@/components/CaseGallery.astro";
import FlowMapDetailed from "@/components/FlowMapDetailed.astro";
import CtaBand from "@/components/CtaBand.astro";
import ProjectNav from "@/components/ProjectNav.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { caseStudyView } from "@/lib/refresh-views";

interface Props {
  project: Project;
  locale: Locale;
}
const { project: p, locale } = Astro.props;
const d = t[locale];
const c = projectByLocale(p, locale);
const v = d.v8.cases;
const accent = p.accent ?? "#d4d4d8";

const hasScreens = p.fallbackScreenshots.length > 0;

// breadcrumb JSON-LD
const crumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "StackLab", item: locale === "fr" ? "/" : "/en/" },
    {
      "@type": "ListItem",
      position: 2,
      name: locale === "fr" ? "Projets" : "Projects",
      item: (locale === "fr" ? "/" : "/en/") + "#projets",
    },
    { "@type": "ListItem", position: 3, name: c.name },
  ],
};
---

<Nav locale={locale} altPath={locale === "fr" ? `/en/projects/${p.slug}/` : `/projets/${p.slug}/`} />

<main id="main" data-cs-hash={`${p.slug}:${hashJson(caseStudyView(p))}`} style={`--pa:${accent}`}>
  <script type="application/ld+json" set:html={JSON.stringify(crumb)} />
  <header class="cs-hero">
    <a class="back" href={d.homeUrl}>← {d.caseStudy.back}</a>
    <h1 data-cs="name">{c.name}</h1>
    <div class="meta">
      <span data-cs="sector">{c.sector}</span>
      <span class="sep">·</span>
      {p.type !== "client" && (
        <span class="demo-badge" data-cs="type-badge">{d.caseStudy.typeBadge[p.type as "demo" | "own"]}</span>
      )}
      {p.tags.slice(0, 3).map((tag) => (
        <span class="mono" style="font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)">
          {tagLabel(tag, locale)}
        </span>
      ))}
    </div>
    <p class="arch-caption" style="margin-top:1.6rem;max-width:58ch;font-size:1rem" data-cs="summary">{c.summary}</p>
  </header>

  <article class="v8case" data-v8-case style={`--pa:${accent}`}>
      <div class="v8case__stage">
        <p class="v8case__kicker">
          {locale === "fr" ? `Étude de cas · ${c.name} — ${c.sector}` : `Case study · ${c.name} — ${c.sector}`}
        </p>

        <div class="v8case__phase" data-v8-phase>
          <p class="v8case__label" data-v8-cs-item>{v.problem}</p>
          <p class="v8case__quote" data-cs="problem" data-v8-cs-item>{c.problem}</p>
        </div>

        <div class="v8case__phase" data-v8-phase>
          <p class="v8case__label" data-v8-cs-item>{v.solution}</p>
          <p class="v8case__quote" data-cs="solution" data-v8-cs-item>{c.solution}</p>
        </div>

        <div class="v8case__phase" data-v8-phase>
          <p class="v8case__label" data-v8-cs-item>{v.result}</p>
          <dl class="v8case__metrics" data-cs="metrics">
            {p.metrics.map((m) => (
              <div data-v8-cs-item>
                <dd class="v">{m.value}<i style="font-style:normal">{m.suffix}</i></dd>
                <dt class="l">{locale === "fr" ? m.labelFr : m.labelEn}</dt>
              </div>
            ))}
          </dl>
          <div class="v8case__actions" data-v8-cs-item>
            <button type="button" class="btn-primary8" data-contact-modal>
              {d.contact.megaCta} <span class="arr" aria-hidden="true">→</span>
            </button>
            {p.liveUrl && (
              <a class="btn-ghost8" href={p.liveUrl} target="_blank" rel="noopener noreferrer">
                {d.v8.projects.live} <span class="arr" aria-hidden="true">↗</span>
              </a>
            )}
          </div>
        </div>
      </div>
    </article>

  <section class="cs-block" style="border-top:1px solid var(--line)">
    <div class="inner" style="max-width:none">
      <h2 set:html={d.caseStudy.featuresTitle} />
      <div class="features" data-cs="features">
        {c.features.map((f) => (
          <div class="feat-row">
            <span class="ft">{f.title}</span>
            <span class="fd">{f.body}</span>
          </div>
        ))}
      </div>
      {p.metrics.length > 1 && (
        <div class="cs-metrics" data-cs="metrics-alt">
          {p.metrics.map((m) => (
            <div>
              <div class="v">{m.value}{m.suffix}</div>
              <div class="l">{locale === "fr" ? m.labelFr : m.labelEn}</div>
            </div>
          ))}
        </div>
      )}
    </div>
  </section>

  {hasScreens && <CaseGallery project={p} locale={locale} />}

  {p.flowDetailed && p.flowDetailed.phases.length > 0 && (
    <section class="cs-block" style="border-top:1px solid var(--line)">
      <div class="inner" style="max-width:none">
        <h2 set:html={d.caseStudy.archTitleText} />
        <FlowMapDetailed locale={locale} slug={p.slug} name={c.name} flow={p.flowDetailed} />
      </div>
    </section>
  )}

  <CtaBand locale={locale} projectName={c.name} />

  <ProjectNav project={p} locale={locale} />
</main>

<SiteFooter locale={locale} />

<script>
  // v8 orchestrator (pins, gallery GL, reveals, Lenis) + runtime refresh.
  import "@/scripts/v8/home";
  import { initRefresh } from "@/lib/refresh";
  initRefresh();
</script>
