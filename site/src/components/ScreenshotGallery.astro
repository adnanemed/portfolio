---
// Screenshot gallery — fallback preview for non-embeddable projects
// (iframeEmbeddable=false): real screenshots in the asymmetric grid.
import { t } from "@/lib/i18n";
import type { Locale, Project } from "@/lib/site";

interface Props {
  project: Project;
  locale: Locale;
}
const { project, locale } = Astro.props;
const d = t[locale];
// 16/10-ish sizing classes cycling through the grid language
const classes = ["s12", "s7", "s5", "s7"];
---

<div class="gallery">
  {project.fallbackScreenshots.map((src, i) => {
    const name = src.split("/").pop()?.replace(".webp", "") ?? src;
    return (
      <figure class={`shot ${classes[i % classes.length]} sr`}>
        <div class="frame">
          <img src={src} alt={`${d.caseStudy.screenshotAlt} — ${locale === "fr" ? project.nameFr : project.nameEn}`} width="1440" height={classes[i % classes.length] === "s12" ? 630 : classes[i % classes.length] === "s5" ? 1080 : 900} loading="lazy" decoding="async" />
        </div>
        <figcaption>
          <span>{name}</span>
          <span class="arr" aria-hidden="true">↗</span>
        </figcaption>
      </figure>
    );
  })}
</div>
