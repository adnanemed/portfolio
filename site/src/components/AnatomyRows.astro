---
// Editorial numbered rows (Law of Similarity) — reused by the
// "Anatomie d'une case study" and "Processus" sections.
interface Props {
  rows: readonly (readonly [string, string])[];
}
const { rows } = Astro.props;
---

<div class="anat">
  {rows.map(([lbl, desc], i) => (
    <div class="anat-row sr">
      <span class="n">{String(i + 1).padStart(2, "0")}</span>
      <span class="lbl" set:html={lbl} />
      <span class="desc">{desc}</span>
    </div>
  ))}
</div>
