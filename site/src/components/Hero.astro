---
// Dual-state hero + Casablanca clock, per approved preview.
import { t } from "@/lib/i18n";
import type { Locale } from "@/lib/site";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t[locale];
---

<header class="hero" id="top">
  <p class="clock" id="clock" data-city={d.hero.clockCity} aria-hidden="true">{d.hero.clockCity} — 00:00:00</p>
  <p class="kicker fadein">{d.hero.kicker}</p>
  <h1 id="heroTitle" class="reveal d1">
    <span class="swap" id="heroSwap">
      <span class="state state-a" set:html={d.hero.stateA} />
      <span class="state state-b" aria-hidden="true" set:html={d.hero.stateB} />
    </span>
  </h1>
  <div class="row2 fadein">
    <p class="sub">{d.hero.sub}</p>
    <a class="btn-wipe" href="#contact">{d.hero.cta} <span class="arr" aria-hidden="true">↗</span></a>
  </div>
</header>
