---
// EN home — mirrors the FR home (hreflang pair handled in Base).
import Base from "@/layouts/Base.astro";
import HomeView from "@/components/HomeView.astro";
import { t } from "@/lib/i18n";

const d = t.en;
---

<Base locale="en" title={d.seo.home.title} description={d.seo.home.description} frPath="/" enPath="/en/">
  <HomeView locale="en" />
</Base>
