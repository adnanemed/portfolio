# StackLab dashboard — environment template (fill with real values, never commit .env)
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require
JWT_SECRET=openssl-rand-base64-48
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=bcrypt-cost-12-hash
RESEND_API_KEY=re_xxx
EMAIL_FROM=StackLab <notifications@your-verified-domain>
CONTACT_EMAIL_TO=team@example.com
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token
CORS_ALLOWED_ORIGINS=https://your-site.vercel.app,http://localhost:4321
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app
BLOB_READ_WRITE_TOKEN=vercel-blob-token
